# copy this file to .env and fill in your real values, .env itself should never
# be committed, it already sits in .gitignore

DB_SERVER=localhost
DB_NAME=IdsProductsPortal
DB_USER=sa
DB_PASSWORD=your_password_here

# used to sign JWTs, needs to be a long random string, at least 32 characters
# generate one with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_real_random_secret
JWT_ISSUER=ids-products-portal
JWT_AUDIENCE=ids-products-portal-client
JWT_EXPIRY_MINUTES=120

# the frontend's dev server origin, so CORS knows who is allowed to call the api
CORS_ALLOWED_ORIGIN=http://localhost:5173
